# Human Loop environment variables.
# Copy to .env.local for local development. Everything here is optional:
# without cloud storage the game still works and saves progress in the browser.

# Cloud save + sign-up storage in Airtable (recommended for DCI). A personal access token from
# https://airtable.com/create/tokens with scopes data.records:read + data.records:write, limited to
# the "Human Loop — Players" base. Used only when DATABASE_URL / POSTGRES_URL are empty.
AIRTABLE_TOKEN=
# Optional: defaults to DCI's "Human Loop — Players" base.
# AIRTABLE_BASE_ID=appp6a1BiX6qyMUkj

# Alternative: cloud save + sign-up storage in Neon Postgres (takes priority over Airtable when set).
# On Vercel this is set for you when you add Neon from the Vercel Marketplace to the "human-loop"
# project (then redeploy).
# POSTGRES_URL is used only if DATABASE_URL is empty.
# DATABASE_URL=
# POSTGRES_URL=

# Sign-ups allowed per IP address per 10 minutes (default 30). Raise it for big events where
# everyone shares one Wi-Fi network.
# LEAD_RATE_LIMIT_PER_10_MIN=30

# Tests only: a DISPOSABLE local Postgres for lib/server/db.pg.test.ts (it drops the tables).
# HL_TEST_PG_URL=postgresql://USER:PASSWORD@localhost:5432/hl_test

# Daily retention job (GET /api/cron/purge, scheduled in vercel.json). Vercel sends it as a
# bearer token. Set any long random string in the project's environment variables. Without it,
# the route refuses every request and the purge still runs (at most daily) after new sign-ups.
# CRON_SECRET=
