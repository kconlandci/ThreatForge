rules_version = '2';

// ThreatForge — Firestore Security Rules
// Each anonymous user may only read/write their own document and
// their own analytics events. No cross-user access, no public reads.
//
// Deploy with:  firebase deploy --only firestore:rules
// (requires the Firebase CLI authenticated to project threatforge-713ca)

service cloud.firestore {
  match /databases/{database}/documents {
    // Progress doc: users/{firebaseAuthUid}
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Analytics events subcollection: users/{uid}/events/{eventId}
    match /users/{uid}/events/{eventId} {
      allow read, create: if request.auth != null && request.auth.uid == uid;
    }
  }
}
